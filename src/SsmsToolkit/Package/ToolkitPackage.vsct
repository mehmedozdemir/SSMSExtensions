<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />

  <Commands package="guidToolkitPackage">
    <Menus>
      <Menu guid="guidToolkitCmdSet" id="ToolkitMenu" priority="0x0100" type="Menu">
        <Parent guid="guidToolkitCmdSet" id="ExtensionsMenuGroup" />
        <Strings>
          <ButtonText>SsmsToolkit</ButtonText>
        </Strings>
      </Menu>
      <!-- "Copy As" submenu in the SSMS results grid context menu. -->
      <Menu guid="guidToolkitCmdSet" id="GridCopyAsMenu" priority="0x0100" type="Menu">
        <Parent guid="guidToolkitCmdSet" id="GridContextGroup" />
        <Strings>
          <ButtonText>Copy As (SsmsToolkit)</ButtonText>
        </Strings>
      </Menu>
    </Menus>

    <Groups>
      <!-- Host group for the SsmsToolkit submenu; placed in Extensions and Tools below. -->
      <Group guid="guidToolkitCmdSet" id="ExtensionsMenuGroup" priority="0x0600" />
      <Group guid="guidToolkitCmdSet" id="ToolkitMenuGroup" priority="0x0100">
        <Parent guid="guidToolkitCmdSet" id="ToolkitMenu" />
      </Group>
      <Group guid="guidToolkitCmdSet" id="ToolkitFeatureGroup" priority="0x0050">
        <Parent guid="guidToolkitCmdSet" id="ToolkitMenu" />
      </Group>
      <!-- Query editor context menu group; placed below. -->
      <Group guid="guidToolkitCmdSet" id="EditorContextGroup" priority="0x0100" />
      <!-- SSMS results grid context menu group; the commands live in the Copy As submenu. -->
      <Group guid="guidToolkitCmdSet" id="GridContextGroup" priority="0x0600">
        <Parent guid="guidSqlEditorMenus" id="IDM_SQL_RESULTS_GRID_CONTEXT" />
      </Group>
      <Group guid="guidToolkitCmdSet" id="GridCopyAsGroup" priority="0x0100">
        <Parent guid="guidToolkitCmdSet" id="GridCopyAsMenu" />
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidToolkitCmdSet" id="InspectTableCommand" priority="0x0100" type="Button">
        <Parent guid="guidToolkitCmdSet" id="ToolkitFeatureGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings>
          <ButtonText>Inspect Table</ButtonText>
          <CanonicalName>SsmsToolkit.InspectTable</CanonicalName>
          <LocCanonicalName>SsmsToolkit.InspectTable</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidToolkitCmdSet" id="DatabaseDashboardCommand" priority="0x0101" type="Button">
        <Parent guid="guidToolkitCmdSet" id="ToolkitFeatureGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings>
          <ButtonText>Database Dashboard</ButtonText>
          <CanonicalName>SsmsToolkit.DatabaseDashboard</CanonicalName>
          <LocCanonicalName>SsmsToolkit.DatabaseDashboard</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidToolkitCmdSet" id="SettingsCommand" priority="0x0100" type="Button">
        <Parent guid="guidToolkitCmdSet" id="ToolkitMenuGroup" />
        <Strings>
          <ButtonText>Settings...</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidToolkitCmdSet" id="OpenLogFolderCommand" priority="0x0101" type="Button">
        <Parent guid="guidToolkitCmdSet" id="ToolkitMenuGroup" />
        <Strings>
          <ButtonText>Open Log Folder</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidToolkitCmdSet" id="AboutCommand" priority="0x0102" type="Button">
        <Parent guid="guidToolkitCmdSet" id="ToolkitMenuGroup" />
        <Strings>
          <ButtonText>About SsmsToolkit</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidToolkitCmdSet" id="GridCopyCsvCommand" priority="0x0100" type="Button">
        <Parent guid="guidToolkitCmdSet" id="GridCopyAsGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings>
          <ButtonText>CSV</ButtonText>
          <CanonicalName>SsmsToolkit.GridCopyAsCsv</CanonicalName>
          <LocCanonicalName>SsmsToolkit.GridCopyAsCsv</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidToolkitCmdSet" id="GridCopyJsonCommand" priority="0x0101" type="Button">
        <Parent guid="guidToolkitCmdSet" id="GridCopyAsGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings>
          <ButtonText>JSON</ButtonText>
          <CanonicalName>SsmsToolkit.GridCopyAsJson</CanonicalName>
          <LocCanonicalName>SsmsToolkit.GridCopyAsJson</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidToolkitCmdSet" id="GridCopyMarkdownCommand" priority="0x0102" type="Button">
        <Parent guid="guidToolkitCmdSet" id="GridCopyAsGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings>
          <ButtonText>Markdown Table</ButtonText>
          <CanonicalName>SsmsToolkit.GridCopyAsMarkdown</CanonicalName>
          <LocCanonicalName>SsmsToolkit.GridCopyAsMarkdown</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidToolkitCmdSet" id="GridCopyInsertCommand" priority="0x0103" type="Button">
        <Parent guid="guidToolkitCmdSet" id="GridCopyAsGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings>
          <ButtonText>INSERT Statements...</ButtonText>
          <CanonicalName>SsmsToolkit.GridCopyAsInsert</CanonicalName>
          <LocCanonicalName>SsmsToolkit.GridCopyAsInsert</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidToolkitCmdSet" id="GridCopyInListCommand" priority="0x0104" type="Button">
        <Parent guid="guidToolkitCmdSet" id="GridCopyAsGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings>
          <ButtonText>IN (...) List</ButtonText>
          <CanonicalName>SsmsToolkit.GridCopyAsInList</CanonicalName>
          <LocCanonicalName>SsmsToolkit.GridCopyAsInList</LocCanonicalName>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <CommandPlacements>
    <!-- Extensions menu (VS 2019+ shell) and Tools menu, in case SSMS hides Extensions. -->
    <CommandPlacement guid="guidToolkitCmdSet" id="ExtensionsMenuGroup" priority="0x0600">
      <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_EXTENSIONS" />
    </CommandPlacement>
    <CommandPlacement guid="guidToolkitCmdSet" id="ExtensionsMenuGroup" priority="0x0600">
      <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS" />
    </CommandPlacement>

    <!-- Editor context menus: the standard code window menu and SSMS's query editor menu. -->
    <CommandPlacement guid="guidToolkitCmdSet" id="EditorContextGroup" priority="0x0100">
      <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_CODEWIN" />
    </CommandPlacement>
    <CommandPlacement guid="guidToolkitCmdSet" id="EditorContextGroup" priority="0x0100">
      <Parent guid="guidSqlEditorMenus" id="IDM_SQL_QUERY_EDITOR_CONTEXT" />
    </CommandPlacement>
    <CommandPlacement guid="guidToolkitCmdSet" id="InspectTableCommand" priority="0x0100">
      <Parent guid="guidToolkitCmdSet" id="EditorContextGroup" />
    </CommandPlacement>
  </CommandPlacements>

  <KeyBindings>
    <!-- Ctrl+K, Ctrl+T (chord avoids Ctrl+Alt, which is AltGr on many keyboard layouts). -->
    <KeyBinding guid="guidToolkitCmdSet" id="InspectTableCommand" editor="guidVSStd97" key1="K" mod1="Control" key2="T" mod2="Control" />
  </KeyBindings>

  <Symbols>
    <GuidSymbol name="guidToolkitPackage" value="{f0914648-f08f-4329-b5b0-290413696d6f}" />
    <GuidSymbol name="guidToolkitCmdSet" value="{c8bf28e8-0341-40d6-ab4a-41d2119ba000}">
      <IDSymbol name="ExtensionsMenuGroup" value="0x1000" />
      <IDSymbol name="ToolkitMenu" value="0x1001" />
      <IDSymbol name="ToolkitMenuGroup" value="0x1002" />
      <IDSymbol name="ToolkitFeatureGroup" value="0x1003" />
      <IDSymbol name="EditorContextGroup" value="0x1004" />
      <IDSymbol name="SettingsCommand" value="0x0100" />
      <IDSymbol name="OpenLogFolderCommand" value="0x0101" />
      <IDSymbol name="AboutCommand" value="0x0102" />
      <IDSymbol name="InspectTableCommand" value="0x0200" />
      <IDSymbol name="DatabaseDashboardCommand" value="0x0201" />
      <IDSymbol name="GridContextGroup" value="0x1005" />
      <IDSymbol name="GridCopyAsMenu" value="0x1006" />
      <IDSymbol name="GridCopyAsGroup" value="0x1007" />
      <IDSymbol name="GridCopyCsvCommand" value="0x0300" />
      <IDSymbol name="GridCopyJsonCommand" value="0x0301" />
      <IDSymbol name="GridCopyMarkdownCommand" value="0x0302" />
      <IDSymbol name="GridCopyInsertCommand" value="0x0303" />
      <IDSymbol name="GridCopyInListCommand" value="0x0304" />
    </GuidSymbol>
    <!--
      SSMS query editor menus (SQLWorkbenchCommands.GUID_SQLEditorGroup in SQLEditors.dll, SSMS 22.12; undocumented).
      Ids read from the SQLEditors IL: SqlScriptEditorControl.ScriptEditorContextMenuID = 0x50 (IDM_VS_CTXT_CODEWIN
      while debugging), DisplaySqlResultsTabControl.WndProc shows 0x70 for the results grid.
    -->
    <GuidSymbol name="guidSqlEditorMenus" value="{33F13AC3-80BB-4ECB-85BC-225435603A5E}">
      <IDSymbol name="IDM_SQL_QUERY_EDITOR_CONTEXT" value="0x0050" />
      <IDSymbol name="IDM_SQL_RESULTS_GRID_CONTEXT" value="0x0070" />
    </GuidSymbol>
  </Symbols>
</CommandTable>
