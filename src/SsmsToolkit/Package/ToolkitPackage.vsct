<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />

  <Commands package="guidToolkitPackage">
    <Menus>
      <Menu guid="guidToolkitCmdSet" id="ToolkitMenu" priority="0x0100" type="Menu">
        <Parent guid="guidToolkitCmdSet" id="ExtensionsMenuGroup" />
        <Strings>
          <ButtonText>SsmsToolkit</ButtonText>
        </Strings>
      </Menu>
    </Menus>

    <Groups>
      <!-- Host group for the SsmsToolkit submenu; placed in Extensions and Tools below. -->
      <Group guid="guidToolkitCmdSet" id="ExtensionsMenuGroup" priority="0x0600" />
      <Group guid="guidToolkitCmdSet" id="ToolkitMenuGroup" priority="0x0100">
        <Parent guid="guidToolkitCmdSet" id="ToolkitMenu" />
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidToolkitCmdSet" id="ShowConnectionCommand" priority="0x0100" type="Button">
        <Parent guid="guidToolkitCmdSet" id="ToolkitMenuGroup" />
        <Strings>
          <ButtonText>Spike: Show Active Connection</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidToolkitCmdSet" id="OpenTestWindowCommand" priority="0x0101" type="Button">
        <Parent guid="guidToolkitCmdSet" id="ToolkitMenuGroup" />
        <Strings>
          <ButtonText>Spike: Open Test Window</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidToolkitCmdSet" id="OpenLogFolderCommand" priority="0x0102" type="Button">
        <Parent guid="guidToolkitCmdSet" id="ToolkitMenuGroup" />
        <Strings>
          <ButtonText>Open Log Folder</ButtonText>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <CommandPlacements>
    <!-- Extensions menu (VS 2019+ shell). -->
    <CommandPlacement guid="guidToolkitCmdSet" id="ExtensionsMenuGroup" priority="0x0600">
      <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_EXTENSIONS" />
    </CommandPlacement>
    <!-- Tools menu as well, in case SSMS hides the Extensions menu. -->
    <CommandPlacement guid="guidToolkitCmdSet" id="ExtensionsMenuGroup" priority="0x0600">
      <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS" />
    </CommandPlacement>
  </CommandPlacements>

  <Symbols>
    <GuidSymbol name="guidToolkitPackage" value="{f0914648-f08f-4329-b5b0-290413696d6f}" />
    <GuidSymbol name="guidToolkitCmdSet" value="{c8bf28e8-0341-40d6-ab4a-41d2119ba000}">
      <IDSymbol name="ExtensionsMenuGroup" value="0x1000" />
      <IDSymbol name="ToolkitMenu" value="0x1001" />
      <IDSymbol name="ToolkitMenuGroup" value="0x1002" />
      <IDSymbol name="ShowConnectionCommand" value="0x0100" />
      <IDSymbol name="OpenTestWindowCommand" value="0x0101" />
      <IDSymbol name="OpenLogFolderCommand" value="0x0102" />
    </GuidSymbol>
  </Symbols>
</CommandTable>
