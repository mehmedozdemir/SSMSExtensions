<UserControl x:Class="SsmsToolkit.Presentation.ResultGrid.InsertScriptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:SsmsToolkit.Presentation.Theme"
             xmlns:l="clr-namespace:SsmsToolkit.Presentation.Localization"
             Background="{DynamicResource {x:Static t:ThemeKeys.Background}}"
             Foreground="{DynamicResource {x:Static t:ThemeKeys.Foreground}}"
             FontSize="12">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SsmsToolkit.Presentation;component/Theme/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static t:ThemeKeys.Foreground}}" />
                <Setter Property="Margin" Value="0,0,18,6" />
            </Style>
            <Style TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static t:ThemeKeys.Foreground}}" />
                <Setter Property="Margin" Value="0,0,18,0" />
            </Style>
            <Style x:Key="Label" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,8,0" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel Margin="12">
        <!-- Target and options -->
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Style="{StaticResource Label}" Text="{l:Loc Insert_Table}" />
            <ComboBox Grid.Column="1" IsEditable="True" ItemsSource="{Binding TableCandidates}"
                      Text="{Binding TableName, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                      FontFamily="Consolas, Courier New" MinWidth="300" HorizontalAlignment="Left"
                      ToolTip="{l:Loc Insert_TableHint}" />

            <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="{l:Loc Insert_Rows}" Margin="0,10,8,0" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                <RadioButton IsChecked="{Binding UseSelectedRows}"><TextBlock Text="{Binding SelectionRowsText}" /></RadioButton>
                <RadioButton IsChecked="{Binding UseAllRows}"
                             Visibility="{Binding HasAllRowsChoice, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding AllRowsText}" />
                </RadioButton>
            </StackPanel>

            <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="{l:Loc Insert_RowsPerStatement}" Margin="0,10,8,0" />
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                <ComboBox ItemsSource="{Binding RowsPerStatementChoices}" SelectedItem="{Binding RowsPerStatement}" Width="80" />
                <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="10,0,0,0" Text="{l:Loc Insert_RowsPerStatementHint}" />
            </StackPanel>
        </Grid>

        <WrapPanel DockPanel.Dock="Top" Margin="0,12,0,4">
            <CheckBox IsChecked="{Binding ExcludeGeneratedColumns}"><TextBlock Text="{l:Loc Insert_ExcludeGenerated}" /></CheckBox>
            <!-- TextBlock content: a plain string would turn "_" in IDENTITY_INSERT into an access key. -->
            <CheckBox IsChecked="{Binding IdentityInsert}" IsEnabled="{Binding CanUseIdentityInsert}"
                      Visibility="{Binding HasIdentityColumn, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{l:Loc Insert_IdentityInsert}" />
            </CheckBox>
            <CheckBox IsChecked="{Binding QuoteIdentifiers}"><TextBlock Text="{l:Loc Insert_Quote}" /></CheckBox>
        </WrapPanel>

        <!-- Buttons, status and progress -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{l:Loc Insert_Copy}" Command="{Binding CopyCommand}" MinWidth="90" />
                <Button Content="{l:Loc Insert_OpenInQuery}" Command="{Binding OpenInQueryCommand}" MinWidth="90" Margin="6,0,0,0" />
                <Button Content="{l:Loc Insert_Save}" Command="{Binding SaveCommand}" MinWidth="90" Margin="6,0,0,0" />
                <Button Content="{l:Loc Insert_Cancel}" Command="{Binding CancelCommand}" MinWidth="80" Margin="6,0,0,0"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="{l:Loc Insert_Close}" Command="{Binding CloseCommand}" MinWidth="80" Margin="6,0,0,0" IsCancel="True" />
            </StackPanel>
            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Margin="0,0,0,3"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DockPanel>

        <!-- Preview -->
        <DockPanel Margin="0,6,0,0">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                <TextBlock Text="{l:Loc Insert_Preview}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding PreviewNote}" Style="{StaticResource MutedText}" Margin="10,0,0,0" />
            </DockPanel>
            <TextBox Style="{StaticResource CodeText}" Text="{Binding Preview, Mode=OneWay}" Padding="6,4"
                     BorderThickness="1" BorderBrush="{DynamicResource {x:Static t:ThemeKeys.Border}}"
                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
        </DockPanel>
    </DockPanel>
</UserControl>
