<UserControl x:Class="SsmsToolkit.Presentation.Dashboard.DatabaseDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:SsmsToolkit.Presentation.Theme"
             xmlns:l="clr-namespace:SsmsToolkit.Presentation.Localization"
             xmlns:d="clr-namespace:SsmsToolkit.Presentation.Dashboard"
             Background="{DynamicResource {x:Static t:ThemeKeys.Background}}"
             Foreground="{DynamicResource {x:Static t:ThemeKeys.Foreground}}"
             FontSize="12">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SsmsToolkit.Presentation;component/Theme/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <d:SeverityToBrushConverter x:Key="SeverityBrush" />
            <d:SeverityToGlyphConverter x:Key="SeverityGlyph" />

            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Margin" Value="0,14,0,6" />
            </Style>

            <Style x:Key="ErrorText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#E04F4F" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,4" />
            </Style>

            <Style x:Key="Bar" TargetType="ProgressBar">
                <Setter Property="Height" Value="4" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="{DynamicResource {x:Static t:ThemeKeys.Border}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static t:ThemeKeys.Link}}" />
            </Style>

            <Style x:Key="ReadOnlyGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="SelectionMode" Value="Single" />
                <Setter Property="SelectionUnit" Value="FullRow" />
                <Setter Property="CanUserSortColumns" Value="True" />
            </Style>

            <!-- Severity badge -->
            <DataTemplate x:Key="Badge">
                <Border Width="18" Height="18" CornerRadius="9" Background="{Binding Converter={StaticResource SeverityBrush}}" VerticalAlignment="Top">
                    <TextBlock Text="{Binding Converter={StaticResource SeverityGlyph}}" Foreground="White" FontWeight="Bold" FontSize="11"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </DataTemplate>

            <!-- Table name that opens the Table Inspector -->
            <DataTemplate x:Key="TableLinkCell">
                <Button Style="{StaticResource LinkButton}" Content="{Binding FullName}" HorizontalAlignment="Left"
                        Command="{Binding DataContext.OpenTableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}" />
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel>
        <!-- Production warning strip -->
        <Border DockPanel.Dock="Top" Background="#B3261E" Padding="10,4"
                Visibility="{Binding IsProduction, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ProductionText}" Foreground="White" FontWeight="Bold" />
        </Border>

        <!-- Header -->
        <DockPanel DockPanel.Dock="Top" Margin="12,10,12,6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{l:Loc Common_Loading}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,10,0"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <Button Content="{l:Loc Common_Refresh}" Command="{Binding RefreshCommand}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{Binding Database}" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" />
            </StackPanel>
        </DockPanel>

        <TextBlock DockPanel.Dock="Top" Text="{Binding Error}" Style="{StaticResource ErrorText}" Margin="12,0,12,6"
                   Visibility="{Binding Error, Converter={StaticResource HasValueToVisibility}}" />

        <!-- Each tab root sets the text colour: inline TabItem content would inherit the selected tab header colour. -->
        <TabControl SelectedIndex="{Binding SelectedTab}" Margin="8,0,8,8"
                    Visibility="{Binding Overview, Converter={StaticResource HasValueToVisibility}}">

            <!-- Overview -->
            <TabItem Header="{l:Loc Dash_Tab_Overview}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              TextElement.Foreground="{DynamicResource {x:Static t:ThemeKeys.Foreground}}">
                    <StackPanel Margin="10">
                        <ItemsControl ItemsSource="{Binding Cards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="190" MinHeight="86" Margin="0,0,10,10" Padding="12,10" CornerRadius="3"
                                            BorderThickness="1" BorderBrush="{DynamicResource {x:Static t:ThemeKeys.Border}}"
                                            Background="{DynamicResource {x:Static t:ThemeKeys.HeaderBackground}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource MutedText}" />
                                            <DockPanel Margin="0,4,0,0">
                                                <Border DockPanel.Dock="Left" Width="10" Height="10" CornerRadius="5" Margin="0,0,6,0" VerticalAlignment="Center"
                                                        Background="{Binding Severity, Converter={StaticResource SeverityBrush}}"
                                                        Visibility="{Binding IsHealth, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Text="{Binding Value}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                            <ProgressBar Style="{StaticResource Bar}" Margin="0,6,0,0" Minimum="0" Maximum="100"
                                                         Value="{Binding Percent, Mode=OneWay, TargetNullValue=0}"
                                                         Visibility="{Binding HasPercent, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap"
                                                       Visibility="{Binding IsHealth, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                            <Button Style="{StaticResource LinkButton}" Content="{Binding Detail}" HorizontalAlignment="Left" Margin="0,4,0,0"
                                                    Command="{Binding DataContext.ShowHealthCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Visibility="{Binding IsHealth, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{l:Loc Dash_Files}" Style="{StaticResource SectionTitle}" />
                        <DataGrid Style="{StaticResource ReadOnlyGrid}" ItemsSource="{Binding Files}" MaxHeight="220">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{l:Loc Dash_Col_File}" Binding="{Binding Name}" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="{l:Loc Col_Type}" Binding="{Binding Type}" />
                                <DataGridTextColumn Header="{l:Loc Dash_Col_Size}" Binding="{Binding Size}" SortMemberPath="SizeMb" />
                                <DataGridTemplateColumn Header="{l:Loc Dash_Col_Used}" SortMemberPath="UsedPercent" MinWidth="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2,1">
                                                <TextBlock Text="{Binding Used}" />
                                                <ProgressBar Style="{StaticResource Bar}" Minimum="0" Maximum="100" Margin="0,2,0,0"
                                                             Value="{Binding UsedPercent, Mode=OneWay, TargetNullValue=0}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{l:Loc Dash_Col_Growth}" Binding="{Binding Growth}" />
                                <DataGridTextColumn Header="{l:Loc Dash_Col_Max}" Binding="{Binding Max}" />
                                <DataGridTextColumn Header="{l:Loc Dash_Col_Path}" Binding="{Binding Path}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="{l:Loc Dash_Properties}" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding Properties}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Property}" Style="{StaticResource MutedText}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Storage -->
            <TabItem Header="{l:Loc Dash_Tab_Storage}">
                <DockPanel Margin="10" TextElement.Foreground="{DynamicResource {x:Static t:ThemeKeys.Foreground}}">
                    <StackPanel DockPanel.Dock="Bottom">
                        <TextBlock Text="{l:Loc Dash_History}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding HistoryNote}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Height="140" Margin="0,6,0,0"
                                      Visibility="{Binding History.Count, Converter={StaticResource HasValueToVisibility}}">
                            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource {x:Static t:ThemeKeys.Border}}" VerticalAlignment="Bottom">
                                <ItemsControl ItemsSource="{Binding History}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Rectangle Width="8" Height="{Binding Height}" Margin="1,0" VerticalAlignment="Bottom"
                                                       Fill="{DynamicResource {x:Static t:ThemeKeys.Link}}" ToolTip="{Binding ToolTip}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </ScrollViewer>
                    </StackPanel>

                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="{l:Loc Dash_Tables}" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="{Binding TablesNote}" Style="{StaticResource MutedText}" Margin="10,2,0,0" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding TablesError}" Style="{StaticResource ErrorText}"
                               Visibility="{Binding TablesError, Converter={StaticResource HasValueToVisibility}}" />
                    <DataGrid Style="{StaticResource ReadOnlyGrid}" ItemsSource="{Binding Tables}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{l:Loc Col_Table}" CellTemplate="{StaticResource TableLinkCell}" SortMemberPath="FullName" Width="260" />
                            <DataGridTextColumn Header="{l:Loc Dash_Col_Rows}" Binding="{Binding Rows, StringFormat=N0}" />
                            <DataGridTemplateColumn Header="{l:Loc Dash_Col_Reserved}" SortMemberPath="ReservedMb" MinWidth="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2,1">
                                            <TextBlock Text="{Binding ReservedMb, StringFormat=N1}" />
                                            <ProgressBar Style="{StaticResource Bar}" Minimum="0" Maximum="1" Margin="0,2,0,0" Value="{Binding Share, Mode=OneWay}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{l:Loc Dash_Col_Data}" Binding="{Binding DataMb, StringFormat=N1}" />
                            <DataGridTextColumn Header="{l:Loc Dash_Col_Index}" Binding="{Binding IndexMb, StringFormat=N1}" />
                            <DataGridTextColumn Header="{l:Loc Dash_Col_Unused}" Binding="{Binding UnusedMb, StringFormat=N1}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Health -->
            <TabItem Header="{l:Loc Dash_Tab_Health}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              TextElement.Foreground="{DynamicResource {x:Static t:ThemeKeys.Foreground}}">
                    <StackPanel Margin="10">
                        <TextBlock Text="{l:Loc Common_Loading}" Style="{StaticResource MutedText}"
                                   Visibility="{Binding HealthLoading, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding HealthError}" Style="{StaticResource ErrorText}"
                                   Visibility="{Binding HealthError, Converter={StaticResource HasValueToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding Findings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource {x:Static t:ThemeKeys.Border}}" Padding="0,8">
                                        <DockPanel>
                                            <ContentPresenter DockPanel.Dock="Left" Content="{Binding Severity}" ContentTemplate="{StaticResource Badge}" Margin="0,0,10,0" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                <Expander Margin="0,4,0,0" Foreground="{DynamicResource {x:Static t:ThemeKeys.Link}}"
                                                          Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}">
                                                    <Expander.Header>
                                                        <TextBlock Text="{l:Loc Dash_Details}" />
                                                    </Expander.Header>
                                                    <StackPanel Margin="20,4,0,0">
                                                        <ItemsControl ItemsSource="{Binding Items}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBox Style="{StaticResource ReadOnlyText}" Text="{Binding Mode=OneWay}"
                                                                             FontFamily="Consolas, Courier New" BorderThickness="0" Padding="0" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <TextBlock Text="{Binding More}" Style="{StaticResource MutedText}"
                                                                   Visibility="{Binding More, Converter={StaticResource HasValueToVisibility}}" />
                                                    </StackPanel>
                                                </Expander>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Objects -->
            <TabItem Header="{l:Loc Dash_Tab_Objects}">
                <Grid Margin="10" TextElement.Foreground="{DynamicResource {x:Static t:ThemeKeys.Foreground}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Margin="0,0,12,0">
                        <TextBlock DockPanel.Dock="Top" Text="{l:Loc Dash_ObjectCounts}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6" />
                        <DataGrid Style="{StaticResource ReadOnlyGrid}" ItemsSource="{Binding ObjectCounts}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{l:Loc Col_Type}" Binding="{Binding TypeDesc}" Width="*" />
                                <DataGridTextColumn Header="#" Binding="{Binding Count, StringFormat=N0}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                    <DockPanel Grid.Column="1">
                        <TextBlock DockPanel.Dock="Top" Text="{l:Loc Dash_Recent}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6" />
                        <TextBlock DockPanel.Dock="Top" Text="{Binding ObjectsError}" Style="{StaticResource ErrorText}"
                                   Visibility="{Binding ObjectsError, Converter={StaticResource HasValueToVisibility}}" />
                        <DataGrid Style="{StaticResource ReadOnlyGrid}" ItemsSource="{Binding Recent}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="{l:Loc Col_Name}" SortMemberPath="FullName" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource TableLinkCell}"
                                                                  Visibility="{Binding IsTableOrView, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Text="{Binding FullName}" Margin="2,0"
                                                           Visibility="{Binding IsTableOrView, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{l:Loc Col_Type}" Binding="{Binding TypeDesc}" />
                                <DataGridTextColumn Header="{l:Loc Dash_Col_Modified}" Binding="{Binding Modified, StringFormat=g}" />
                                <DataGridTextColumn Header="{l:Loc Dash_Col_Created}" Binding="{Binding Created, StringFormat=g}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
