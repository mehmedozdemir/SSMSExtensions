<UserControl x:Class="SsmsToolkit.Presentation.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:SsmsToolkit.Presentation.Theme"
             xmlns:l="clr-namespace:SsmsToolkit.Presentation.Localization"
             xmlns:s="clr-namespace:SsmsToolkit.Presentation.Settings"
             Background="{DynamicResource {x:Static t:ThemeKeys.Background}}"
             Foreground="{DynamicResource {x:Static t:ThemeKeys.Foreground}}"
             FontSize="12">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SsmsToolkit.Presentation;component/Theme/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,10,0,3" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static t:ThemeKeys.Foreground}}" />
            </Style>

            <DataTemplate DataType="{x:Type s:TableInspectorSettingsViewModel}">
                <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Loc TI_Trigger}" />
                    <ComboBox ItemsSource="{Binding Triggers}" SelectedValuePath="Value" DisplayMemberPath="Display"
                              SelectedValue="{Binding Trigger}" Width="320" HorizontalAlignment="Left" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Loc TI_OpenMode}" />
                    <ComboBox ItemsSource="{Binding OpenModes}" SelectedValuePath="Value" DisplayMemberPath="Display"
                              SelectedValue="{Binding OpenMode}" Width="320" HorizontalAlignment="Left" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Loc TI_RowLimit}" />
                    <TextBox Text="{Binding RowLimit, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Loc TI_Timeout}" />
                    <TextBox Text="{Binding CommandTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left" />

                    <CheckBox Margin="0,12,0,0" IsChecked="{Binding ReadUncommitted}">
                        <TextBlock Text="{l:Loc TI_ReadUncommitted}" TextWrapping="Wrap" />
                    </CheckBox>

                    <TextBlock Margin="0,14,0,0" Style="{StaticResource MutedText}" Text="{l:Loc TI_ShortcutNote}" />
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Text="{l:Loc Settings_Title}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="{l:Loc Settings_Save}" Command="{Binding SaveCommand}" MinWidth="90" />
            <Button DockPanel.Dock="Left" Content="{l:Loc Settings_OpenLogFolder}" Command="{Binding OpenLogFolderCommand}" Margin="0" />
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="12,0" Style="{StaticResource MutedText}" />
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Features -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" Text="{l:Loc Settings_Features}" />
                <ListBox ItemsSource="{Binding Features}" SelectedItem="{Binding SelectedFeature}"
                         Background="{DynamicResource {x:Static t:ThemeKeys.Background}}"
                         Foreground="{DynamicResource {x:Static t:ThemeKeys.Foreground}}"
                         BorderBrush="{DynamicResource {x:Static t:ThemeKeys.Border}}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="6" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static t:ThemeKeys.HoverBackground}}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static t:ThemeKeys.SelectionBackground}}" />
                                                <Setter Property="Foreground" Value="{DynamicResource {x:Static t:ThemeKeys.SelectionForeground}}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" Margin="0,0,8,0"
                                          ToolTip="{l:Loc Settings_Enabled}" />
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Selected feature + general -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedFeature.DisplayName}" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedFeature.Description}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                    <ContentControl Content="{Binding SelectedFeature.Settings}" Margin="0,4,0,0" />
                    <TextBlock Text="{l:Loc Settings_NoFeatureSettings}" Style="{StaticResource MutedText}" Margin="0,8,0,0"
                               Visibility="{Binding SelectedFeature.Settings, Converter={StaticResource HasValueToVisibility}, ConverterParameter=Invert}" />

                    <Separator Margin="0,18,0,6" />
                    <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Loc Settings_General}" FontSize="15" />

                    <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Loc Settings_ProductionPatterns}" />
                        <TextBox Text="{Binding ProductionPatterns, UpdateSourceTrigger=PropertyChanged}" Width="420" HorizontalAlignment="Left" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Loc Settings_Language}" />
                        <ComboBox ItemsSource="{Binding Languages}" SelectedValuePath="Value" DisplayMemberPath="Display"
                                  SelectedValue="{Binding Language}" Width="320" HorizontalAlignment="Left" />
                        <TextBlock Style="{StaticResource MutedText}" Text="{l:Loc Settings_LanguageNote}" Margin="0,2,0,0" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Loc Settings_LogLevel}" />
                        <ComboBox ItemsSource="{Binding LogLevels}" SelectedValuePath="Value" DisplayMemberPath="Display"
                                  SelectedValue="{Binding LogLevel}" Width="320" HorizontalAlignment="Left" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
